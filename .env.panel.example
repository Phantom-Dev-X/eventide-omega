# ═══════════════════════════════════════════════════════════════════════
#  EVENTIDE OMEGA — PANEL (VPS / Pterodactyl / etc.) ENV TEMPLATE
#  Persistent disk → NO Telegram backup needed (but you can add it).
# ═══════════════════════════════════════════════════════════════════════

# ── Node ───────────────────────────────────────────────────────────────
NODE_ENV=production

# ── Port (your choice — 5000, 5001, 5002… if running multiple on 1 box)
PORT=5000

# ── Admin login for /login.html ───────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_me_to_a_strong_one

# ── User cap (15 per panel instance) ──────────────────────────────────
MAX_USERS=15

# ── CORS: only your Vercel site can call this bot's API ───────────────
# Comma-separated. Use https://your-site.vercel.app (no trailing slash).
ALLOWED_ORIGINS=https://your-site.vercel.app

# ── OPTIONAL: Telegram backup (belt-and-suspenders for VPS too) ──────
# Even though persistent disk saves you, Telegram gives you offsite
# backup. Same setup as Render: bot, private channel, channel ID.
# Leave blank/commented if you don't want it.
# TELEGRAM_TOKEN=
# TELEGRAM_BACKUP_CHANNEL=

# ── Optional: Google Maps (street-level .weather) ─────────────────────
# GOOGLE_MAPS_API_KEY=

# ── Optional: NewsAPI (richer .news) ──────────────────────────────────
# NEWS_API_KEY=
