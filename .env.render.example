# ═══════════════════════════════════════════════════════════════════════
#  EVENTIDE OMEGA — RENDER ENV TEMPLATE
#  Use these values in the Render dashboard (Environment tab).
#  Free tier = ephemeral disk → Telegram backup is REQUIRED.
# ═══════════════════════════════════════════════════════════════════════

# ── Node ───────────────────────────────────────────────────────────────
NODE_VERSION=20.20.2
NODE_ENV=production

# ── Port (Render exposes 10000 externally) ────────────────────────────
PORT=10000

# ── REQUIRED on Render: Telegram backup (no persistent disk!) ─────────
# Create via @BotFather → /newbot → paste token below.
# Create a PRIVATE channel → add bot as Admin (post + pin).
# Get channel ID: forward a msg to @userinfobot OR call
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# The ID looks like -1001234567890 (include the minus sign).
TELEGRAM_TOKEN=123456789:AAxxxx_your_token_here
TELEGRAM_BACKUP_CHANNEL=-1001234567890

# ── REQUIRED: Admin login for /login.html ─────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_me_to_a_strong_one

# ── User cap (15 per Render instance) ─────────────────────────────────
MAX_USERS=15

# ── CORS: only your Vercel site can call this bot's API ───────────────
# Comma-separated. Use https://your-site.vercel.app (no trailing slash).
ALLOWED_ORIGINS=https://your-site.vercel.app

# ── Optional: yt-dlp / ffmpeg installed in buildCommand ───────────────
# (handled by render.yaml buildCommand, no env needed)

# ── RECOMMENDED: Local Cobalt downloader (self-hosted on your VPS) ─────
# Self-hosted cobalt = FASTEST, MOST RELIABLE downloader tier.
# Setup on VPS: bash setup-cobalt.sh (in this repo)
# Then set:
# COBALT_LOCAL_URL=http://YOUR_VPS_IP:9000/
# COBALT_LOCAL_KEY=<the secret key generated by setup-cobalt.sh>
# Leave both blank to skip the local tier and use public cobalt / yt-dlp.

# ── Optional: Google Maps (street-level .weather) ─────────────────────
# GOOGLE_MAPS_API_KEY=

# ── Optional: NewsAPI (richer .news) ──────────────────────────────────
# NEWS_API_KEY=
