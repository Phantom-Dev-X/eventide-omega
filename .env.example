# ═══════════════════════════════════════════════════════════════════════
#  PHANTOM-X (EVENTIDE OMEGA) — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── Web Dashboard Admin Login ────────────────────────────────────────────
# Used to sign in at /login.html and generate pairing codes.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_now

# ── Telegram Bot (Backup & Restore) ─────────────────────────────────────
# Required on Render (ephemeral disk). Optional but recommended everywhere.
# 1. Create a bot via @BotFather → paste the token below.
# 2. Create a PRIVATE channel → add the bot as Admin.
# 3. Get the channel ID (use @userinfobot or check the channel URL).
TELEGRAM_TOKEN=123456789:AAxxxx-your-token-here
TELEGRAM_BACKUP_CHANNEL=-1001234567890

# ── User Limit (per instance) ────────────────────────────────────────────
# How many WhatsApp sessions this instance will serve. 0 = unlimited.
# Recommended: 15 per instance for stable performance.
MAX_USERS=15

# ── CORS Allowed Origins ─────────────────────────────────────────────────
# Comma-separated list of origins that can call this bot's API.
# Used when pair.html is hosted on Vercel and calls the bot on Render.
# Example: https://my-site.vercel.app,https://another.com
# Leave blank to allow all origins (fine for private/closed bots).
ALLOWED_ORIGINS=

# ── Optional: Google Maps API ────────────────────────────────────────────
# Improves .weather command (street-level accuracy). Falls back to Nominatim.
# Get a free key: https://console.cloud.google.com/
# GOOGLE_MAPS_API_KEY=

# ── Optional: NewsAPI ────────────────────────────────────────────────────
# Improves .news command. Falls back to Google News RSS if unset.
# Free tier (100 req/day): https://newsapi.org/
# NEWS_API_KEY=
